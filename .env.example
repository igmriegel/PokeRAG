# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
LOCAL_UID=1000
LOCAL_GID=1000

# API Authentication
API_AUTH_ENABLED=true
API_AUTH_SECRET=change_me_api_auth_secret
API_AUTH_ISSUER=poketcg-rag
API_AUTH_AUDIENCE=poketcg-rag-api
API_AUTH_ALGORITHM=HS256
API_AUTH_TOKEN_LIFETIME_SECONDS=3600
POKERAG_API_TOKEN=

# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.0

# Embedding Strategy Configuration
EMBEDDING_MODEL_PRIMARY=BAAI/bge-large-en-v1.5
EMBEDDING_MODEL_SECONDARY=text-embedding-3-small
EMBEDDING_DIMENSION=1024

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=pokemon_tcg_rules
QDRANT_API_KEY=

# Relational Database (PostgreSQL - Feedback & Logs)
POSTGRES_USER=change_me_postgres_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=pokemon_tcg_rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Hybrid Retrieval & Reranking Settings
RETRIEVAL_TOP_K_DENSE=10
RETRIEVAL_TOP_K_BM25=10
RETRIEVAL_HYBRID_RRF_K=60
RERANKER_MODEL=BAAI/bge-reranker-large
RETRIEVAL_FINAL_TOP_K=5

# Ingestion Settings
DATA_RAW_DIR=data/raw_data
DATA_PROCESSED_DIR=data/processed
DATA_CHUNKS_DIR=data/chunks

# Streamlit Interface
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
POKERAG_API_URL=http://localhost:8000/api/v1

# Prometheus Monitoring
PROMETHEUS_METRICS_PORT=9090

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=change_me_grafana_user
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
